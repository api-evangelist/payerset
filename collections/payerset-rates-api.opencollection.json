{
  "opencollection": "1.0.0",
  "info": {
    "name": "Payerset Data Lake Billing Codes Rates API",
    "version": "2024-10-31"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Rates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query negotiated rate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.payerset.com/v1/rates/rate_query",
            "params": [
              {
                "name": "billing_code",
                "value": "",
                "type": "query",
                "description": "Service billing code (e.g., CPT/HCPCS/MS-DRG such as \"27447\")."
              },
              {
                "name": "payer",
                "value": "",
                "type": "query",
                "description": "Payer system name (e.g., \"Aetna\")."
              },
              {
                "name": "npi",
                "value": "",
                "type": "query",
                "description": "National Provider Identifier of the provider."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns the negotiated rate(s) for a given combination of billing code, payer, and provider NPI, derived from payer Transparency in Coverage machine-readable files."
        }
      ]
    }
  ],
  "bundled": true
}