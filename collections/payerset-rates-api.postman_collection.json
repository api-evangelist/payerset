      "name": "Rates",
      "description": {
        "content": "Payer-provider negotiated rate lookups from Transparency in Coverage MRFs.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cc237b9b-a633-40ca-875a-400595b50da1",
          "name": "Query negotiated rate",
          "request": {
            "name": "Query negotiated rate",
            "description": {
              "content": "Returns the negotiated rate(s) for a given combination of billing code, payer, and provider NPI, derived from payer Transparency in Coverage machine-readable files.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "rates",
                "rate_query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "billing_code",
                  "value": "<string>",
                  "description": "(Required) Service billing code (e.g., CPT/HCPCS/MS-DRG such as \"27447\")."
                },
                {
                  "disabled": false,
                  "key": "payer",
                  "value": "<string>",
                  "description": "(Required) Payer system name (e.g., \"Aetna\")."
                },
                {
                  "disabled": false,
                  "key": "npi",
                  "value": "<string>",
                  "description": "(Required) National Provider Identifier of the provider."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
