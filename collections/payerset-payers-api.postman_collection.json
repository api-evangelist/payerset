  "info": {
    "_postman_id": "500ab1d8-084e-4771-a9b8-398d90e4279b",
    "name": "Payerset Data Lake Billing Codes Payers API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Payerset Data Lake API provides programmatic access to U.S. healthcare price transparency data parsed from payer Transparency in Coverage (TiC) machine-readable files and hospital price transparency MRFs, enriched with provider, payer, and billing-code reference metadata. Endpoints support payer/provider negotiated rate lookups, NPI and TIN provider mapping, billing-code classification, and hospital MRF discovery. Authentication is via an API key supplied in the x-api-key header.\n\nContact Support:\n Name: Payerset Support\n Email: support@payerset.com",
      "type": "text/plain"
    }
  }
